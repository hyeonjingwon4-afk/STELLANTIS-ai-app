];

const LINE_LABELS = ['1호기', '2호기', '3호기', '4호기'];

const DEFAULT_CLIP_WASTE_TYPES = [
  '길이 미달',
  '길이 초과',
  '끝단부 불량',
  '클립홀 찢어짐',
