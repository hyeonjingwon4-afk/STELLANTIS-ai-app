<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <base target="_self" />
  <title>스텔란티스 생산 현장 작업 & 인원 관리 시스템</title>
  
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚙️</text></svg>" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap');

    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --bg-input: #0f172a;
      --border-color: #334155;
      --border-focus: #3b82f6;
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --accent-blue: #3b82f6;
      --accent-blue-hover: #2563eb;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #ef4444;
      --accent-purple: #8b5cf6;
      --glass-bg: rgba(30, 41, 59, 0.85);
      --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5);
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 18px;
      --radius-full: 9999px;
      --font-family: 'Noto Sans KR', -apple-system, sans-serif;
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--font-family); background: var(--bg-main); color: var(--text-primary); min-height: 100vh; overflow-x: hidden; line-height: 1.6; letter-spacing: -0.01em; }
    #app { display: flex; flex-direction: column; min-height: 100vh; }

    .top-navbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.85rem 1.5rem; background: var(--glass-bg); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;
    }
    .brand-container { display: flex; align-items: center; gap: 0.75rem; }
    .brand-logo {
      width: 38px; height: 38px; background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
      border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;
      color: white; font-size: 1.2rem; box-shadow: 0 4px 12px rgba(59,130,246,0.4);
    }
    .brand-title h1 { font-size: 1.05rem; font-weight: 800; color: #ffffff; }
    .brand-title span { font-size: 0.75rem; color: #60a5fa; font-weight: 600; }

    .mode-switcher { display: flex; background: rgba(15,23,42,0.8); padding: 3px; border-radius: var(--radius-full); border: 1px solid var(--border-color); }
    .mode-btn {
      padding: 0.45rem 1.1rem; border: none; background: transparent;
      color: var(--text-secondary); font-weight: 600; font-size: 0.85rem;
      border-radius: var(--radius-full); cursor: pointer; transition: var(--transition);
      display: flex; align-items: center; gap: 0.4rem;
    }
    .mode-btn.active { background: var(--accent-blue); color: white; box-shadow: 0 2px 8px rgba(59,130,246,0.5); }
    .mode-btn:hover:not(.active) { color: var(--text-primary); }

    .main-wrapper { flex: 1; padding: 1.5rem; max-width: 1600px; width: 100%; margin: 0 auto; }
    .view-section { display: none; animation: fadeIn 0.3s ease; }
    .view-section.active { display: block; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }

    @media (max-width: 1024px) { .grid-4 { grid-template-columns: 1fr 1fr; } .grid-3 { grid-template-columns: 1fr; } }
    @media (max-width: 640px) {
      .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
      .main-wrapper { padding: 0.4rem; }
      .card { padding: 0.75rem; margin-bottom: 0.5rem; }
      .top-navbar { padding: 0.5rem 0.75rem; }
      .card-title { font-size: 0.9rem; }
      body { font-size: 0.85rem; line-height: 1.35; }
      .btn { padding: 0.4rem 0.8rem; font-size: 0.8rem; }
      .form-control, .form-select { padding: 0.45rem 0.6rem; font-size: 0.8rem; }
      .form-label { margin-bottom: 0.2rem; font-size: 0.75rem; }
      .form-group { margin-bottom: 0.6rem; }
      .mode-btn { padding: 0.35rem 0.6rem; font-size: 0.75rem; }
      .brand-title h1 { font-size: 0.9rem; }
      .brand-title span { font-size: 0.65rem; }
    }
    .mb-1 { margin-bottom: 0.4rem !important; } .mb-2 { margin-bottom: 0.75rem !important; }
    .mb-3 { margin-bottom: 1.25rem !important; } .mb-4 { margin-bottom: 2rem !important; }
    .mt-2 { margin-top: 0.75rem !important; } .mt-3 { margin-top: 1.25rem !important; }
    .text-center { text-align: center !important; }

    .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.35rem; box-shadow: 0 2px 8px rgba(0,0,0,0.25); }
    .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .card-title { font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; color: #ffffff; }
    .card-title i { color: var(--accent-blue); }

    .kpi-card { display: flex; align-items: center; gap: 1.2rem; padding: 1.2rem 1.4rem; background: linear-gradient(145deg,#1e293b,#172033); border: 1px solid var(--border-color); border-radius: var(--radius-md); position: relative; overflow: hidden; }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--accent-blue); }
    .kpi-card.emerald::before { background: var(--accent-emerald); }
    .kpi-card.amber::before { background: var(--accent-amber); }
    .kpi-card.rose::before { background: var(--accent-rose); }
    .kpi-icon { width: 48px; height: 48px; border-radius: var(--radius-md); background: rgba(59,130,246,0.15); color: var(--accent-blue); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .kpi-card.emerald .kpi-icon { background: rgba(16,185,129,0.15); color: var(--accent-emerald); }
    .kpi-card.amber .kpi-icon { background: rgba(245,158,11,0.15); color: var(--accent-amber); }
    .kpi-card.rose .kpi-icon { background: rgba(239,68,68,0.15); color: var(--accent-rose); }

    .kpi-val { font-size: 1.6rem; font-weight: 900; line-height: 1.2; color: #ffffff; }
    .kpi-label { font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.1rem; }

    .form-group { margin-bottom: 1rem; }
    .form-label { display: block; font-size: 0.85rem; font-weight: 600; color: #e2e8f0; margin-bottom: 0.4rem; }
    .form-control, .form-select {
      width: 100%; padding: 0.65rem 0.9rem; background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.9rem; font-family: var(--font-family);
      transition: var(--transition);
    }
    .form-control:focus, .form-select:focus { outline: none; border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(59,130,246,0.25); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.65rem 1.25rem; font-size: 0.9rem; font-weight: 700; border-radius: var(--radius-sm);
      border: none; cursor: pointer; transition: var(--transition); text-decoration: none;
    }
    .btn-primary { background: var(--accent-blue); color: white; }
    .btn-primary:hover { background: var(--accent-blue-hover); box-shadow: 0 4px 12px rgba(59,130,246,0.35); }
    .btn-secondary { background: #334155; color: var(--text-primary); }
    .btn-secondary:hover { background: #475569; }
    .btn-emerald { background: var(--accent-emerald); color: white; }
    .btn-emerald:hover { background: #059669; }
    .btn-rose { background: var(--accent-rose); color: white; }
    .btn-rose:hover { background: #dc2626; }
    .btn-outline { background: transparent; border: 1px solid var(--border-color); color: var(--text-primary); }
    .btn-outline:hover { background: rgba(255,255,255,0.05); }
    .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; }
    .btn-block { width: 100%; }

    .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.55rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 700; }
    .badge-blue { background: rgba(59,130,246,0.2); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
    .badge-emerald { background: rgba(16,185,129,0.2); color: #34d399; border: 1px solid rgba(16,185,129,0.3); }
    .badge-amber { background: rgba(245,158,11,0.2); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
    .badge-rose { background: rgba(239,68,68,0.2); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
    .badge-purple { background: rgba(139,92,246,0.2); color: #c084fc; border: 1px solid rgba(139,92,246,0.3); }

    .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .data-table th, .data-table td { padding: 0.75rem 0.9rem; text-align: left; border-bottom: 1px solid var(--border-color); }
    .data-table th { background: rgba(15,23,42,0.6); color: #cbd5e1; font-weight: 700; font-size: 0.8rem; }
    .data-table th.sortable { cursor: pointer; user-select: none; transition: background 0.2s; }
    .data-table th.sortable:hover { background: rgba(255, 255, 255, 0.05); }
    .data-table th.sortable i { font-size: 0.85rem; margin-left: 2px; color: #64748b; }
    .data-table th.sortable.active { color: #60a5fa; }
    .data-table th.sortable.active i { color: #60a5fa; }
    .data-table tbody tr:hover { background: rgba(255,255,255,0.02); }

    .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

    .modal-backdrop {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(15,23,42,0.85); backdrop-filter: blur(8px); z-index: 1000;
      display: none; align-items: center; justify-content: center; padding: 1rem;
    }
    .modal-backdrop.open { display: flex; }
    .modal-container {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: var(--radius-lg); width: 100%; max-width: 600px;
      max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-lg);
      animation: modalUp 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .modal-container.modal-lg { max-width: 1240px; width: 94vw; }
    @keyframes modalUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border-color); }
    .modal-title { font-size: 1.1rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 0.5rem; }
    .modal-body { padding: 1.5rem; }
    .modal-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 0.75rem; }

    .custom-checkbox-card {
      display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 1rem;
      background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm);
      cursor: pointer; transition: var(--transition); user-select: none; margin-bottom: 0.5rem;
    }
    .custom-checkbox-card:hover { border-color: var(--accent-blue); }
    .custom-checkbox-card input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent-blue); cursor: pointer; }
    .custom-checkbox-card span { font-size: 0.88rem; font-weight: 500; }

    .downtime-emergency-card {
      border: 2px solid var(--accent-rose) !important;
      background: rgba(239, 68, 68, 0.08) !important;
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.2);
    }

    .step-pills { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
    .step-pill { flex: 1; text-align: center; padding: 0.6rem; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 700; color: var(--text-muted); }
    .step-pill.active { background: rgba(59,130,246,0.15); border-color: var(--accent-blue); color: var(--accent-blue); }
    .step-pill.done { background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.3); color: var(--accent-emerald); }

    .clip-spec-box { background: rgba(15,23,42,0.9); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem; }
    .clip-sub-card { background: rgba(30,41,59,0.6); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem; }
    
    .clip-line-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .clip-line-tab { background: transparent; border: 1px solid var(--border-color); color: var(--text-secondary); padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; transition: all 0.2s; font-weight: 600; font-size: 0.85rem; }
    .clip-line-tab:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .clip-line-tab.active { background: var(--accent-blue); color: white; border-color: var(--accent-blue); box-shadow: 0 2px 8px rgba(59,130,246,0.4); }
    .prep-tab-btn.active { background: var(--accent-emerald); color: white; border-color: var(--accent-emerald); box-shadow: 0 2px 8px rgba(16,185,129,0.4); font-weight: 800; transform: scale(1.02); }
    .floating-log-btn {
      position: fixed; bottom: 1.5rem; left: 1.5rem; background: var(--accent-blue); color: white;
      border: none; border-radius: 50px; padding: 0.75rem 1.25rem; font-weight: 700;
      box-shadow: 0 4px 12px rgba(59,130,246,0.4); z-index: 1000; display: none;
      align-items: center; gap: 0.5rem; cursor: pointer; transition: all 0.2s ease;
    }
    .floating-log-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(59,130,246,0.5); }
    .floating-log-btn.visible { display: flex; }
    .log-popup-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6);
      z-index: 1001; display: none; align-items: flex-end; justify-content: flex-start; backdrop-filter: blur(4px);
    }
    .log-popup-overlay.active { display: flex; }
    .log-popup-panel {
      background: var(--surface); width: 100%; max-width: 400px; height: 80vh; max-height: 600px;
      border-radius: 20px 20px 0 0; box-shadow: 0 -10px 25px rgba(0,0,0,0.15); display: flex;
      flex-direction: column; animation: slideUp 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    @media (min-width: 768px) {
      .log-popup-overlay { align-items: flex-end; padding: 1.5rem; }
      .log-popup-panel { height: auto; max-height: 70vh; border-radius: 16px; }
    }
    .log-popup-header { padding: 1.25rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
    .log-popup-body { padding: 1rem; flex: 1; overflow-y: auto; }
    .log-popup-item {
      padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 0.75rem;
      cursor: pointer; transition: all 0.2s; background: var(--bg-card);
    }
    .log-popup-item:hover { border-color: var(--accent-blue); box-shadow: 0 2px 8px rgba(0,0,0,0.2); }
    .log-popup-item.active-item { border-color: var(--accent-blue); border-left: 4px solid var(--accent-blue); background: rgba(59,130,246,0.15); }
    .log-popup-footer { padding: 1rem; border-top: 1px solid var(--border-color); }
  </style>
</head>
<body>
  <div id="app">
    <nav class="top-navbar">
      <div class="brand-container">
        <div class="brand-logo"><i class="ri-settings-5-fill"></i></div>
        <div class="brand-title">
          <h1>스텔란티스 생산 현장 작업일지</h1>
          <span>DT CREW / DT QUAD 라인 통합 관리</span>
        </div>
      </div>
      <div class="mode-switcher">
        <button type="button" class="mode-btn active" id="btn-mode-worker"><i class="ri-user-3-line"></i> 근로자 작성</button>
        <button type="button" class="mode-btn" id="btn-mode-manager"><i class="ri-dashboard-3-line"></i> 관리자 대시보드</button>
      </div>
    </nav>

    <main class="main-wrapper">
      <section id="view-worker" class="view-section active">
        <div style="max-width:840px;margin:0 auto;">
          <div class="card mb-3" style="background:linear-gradient(135deg,#1e293b,#0f172a);border-left:4px solid #3b82f6;color:#ffffff;box-shadow:0 4px 14px rgba(15,23,42,0.12);">
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
              <div>
                <span class="badge badge-blue mb-1" style="background:#3b82f6;color:#ffffff;border:none;font-weight:700;">모바일 최적화 일지</span>
                <h2 style="font-size:1.35rem;font-weight:900;color:#ffffff;margin-top:0.25rem;">스텔란티스 생산 일지 작성</h2>
              </div>
              <span class="badge badge-purple" style="font-size:0.85rem;padding:0.3rem 0.75rem;">DT CREW/QUAD D/SIDE</span>
            </div>
          </div>

          <div class="step-pills">
            <div class="step-pill active" id="pill-1">1. 본인 확인</div>
            <div class="step-pill" id="pill-2">2. 공정 선택</div>
            <div class="step-pill" id="pill-3">3. 일지 작성</div>
          </div>

          <div id="step1" class="card mb-3">
            <div class="card-header">
              <div class="card-title"><i class="ri-user-check-line"></i> 1. 근로자 본인 확인</div>
            </div>
            <div class="grid-2">
              <div class="form-group">
                <label class="form-label">작업자 성명 *</label>
                <input type="text" class="form-control" id="w-name" placeholder="성함 입력 (예: 홍길동)" />
              </div>
              <div class="form-group">
                <label class="form-label">생년월일 (6자리) *</label>
                <input type="text" class="form-control" id="w-birth" placeholder="YYMMDD (예: 920514)" maxlength="6" />
              </div>
            </div>
            <button type="button" class="btn btn-primary btn-block" id="btn-step1-next">다음 단계로 (공정 선택) <i class="ri-arrow-right-line"></i></button>
          </div>

          <div id="step2" class="card mb-3" style="display:none;">
            <div class="card-header">
              <div class="card-title"><i class="ri-git-merge-line"></i> 2. 담당 차종 &amp; 공정 선택</div>
              <button type="button" class="btn btn-outline btn-sm" id="btn-step2-back"><i class="ri-arrow-left-line"></i> 이전</button>
            </div>
            <div class="grid-3 mb-2">
              <div class="form-group">
                <label class="form-label">제조사</label>
                <select class="form-select" id="w-mfg"></select>
              </div>
              <div class="form-group">
                <label class="form-label">차종 모델</label>
                <select class="form-select" id="w-model"></select>
              </div>
              <div class="form-group">
                <label class="form-label">부품명</label>
                <select class="form-select" id="w-part"></select>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">담당 공정 *</label>
              <select class="form-select" id="w-proc"></select>
            </div>
            <button type="button" class="btn btn-primary btn-block" id="btn-step2-next">일지 작성 시작하기 <i class="ri-edit-line"></i></button>
          </div>

          <div id="step3" style="display:none;">
            <div class="card mb-3">
              <div class="card-header">
                <div class="card-title" id="prework-title"><i class="ri-shield-check-line"></i> 1. 작업 시작 전 점검 일지</div>
                <span class="badge badge-amber" id="prework-status-badge">미완료</span>
              </div>
              <div id="checklist-container" class="mb-3"></div>
              <button type="button" class="btn btn-emerald btn-block" id="btn-prework-submit"><i class="ri-check-double-line"></i> 점검 완료 및 근무 시작 기록</button>
            </div>

            <div id="clip-spec-card" class="card mb-3" style="display:none;">
              <div class="card-header">
                <div class="card-title" style="color:var(--accent-purple);"><i class="ri-tools-line"></i> 클립머신 준비 작업일보 서식</div>
                <span class="badge badge-purple">DT CREW/QUAD D/SIDE</span>
              </div>

              <div class="clip-line-tabs">
                <div class="clip-line-tab active" data-cline="1호기">1호기 일지</div>
                <div class="clip-line-tab" data-cline="2호기">2호기 일지</div>
                <div class="clip-line-tab" data-cline="3호기">3호기 일지</div>
                <div class="clip-line-tab" data-cline="4호기">4호기 일지</div>
              </div>

              <div class="clip-spec-box">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
                  <strong id="clip-active-line-title" style="color:#ffffff;font-size:1.05rem;"><i class="ri-cpu-line"></i> [ 1호기 일지 작성 ]</strong>
                  <span class="badge badge-blue" id="clip-active-line-badge">1호기 전용 생산품목</span>
                </div>
                
                <div class="grid-2">
                  <div class="form-group">
                    <label class="form-label">① 생산 품목 선택</label>
                    <select class="form-select" id="clip-single-item-sel"></select>
                  </div>
                  <div class="form-group">
                    <label class="form-label">② 작업시간</label>
                    <div style="display:flex;align-items:center;gap:0.3rem;">
                      <input type="time" class="form-control" id="clip-single-t-start" value="08:00" />
                      <span>~</span>
                      <input type="time" class="form-control" id="clip-single-t-end" value="17:00" />
                    </div>
                  </div>
                </div>

                <div class="clip-sub-card">
                  <label class="form-label mb-1">③ 압출소재 (LOT No.)</label>
                  <div class="grid-3">
                    <input type="text" class="form-control" id="clip-single-lot-init" placeholder="초물 LOT No." />
                    <input type="text" class="form-control" id="clip-single-lot-mid" placeholder="중물 LOT No." />
                    <input type="text" class="form-control" id="clip-single-lot-fin" placeholder="종물 LOT No." />
                  </div>
                </div>

                <div class="clip-sub-card">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;flex-wrap:wrap;gap:0.3rem;">
                    <label class="form-label mb-0">📐 ④ 치수 확인</label>
                    <span class="badge badge-purple" id="clip-single-spec-tag">기준값 표기</span>
                  </div>
                  <div class="table-responsive">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>구분</th>
                          <th>전장길이 (mm)</th>
                          <th>끝단 클립 간격 (시작/끝) (mm)</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr><td><strong>초물</strong></td><td><input type="number" step="0.1" class="form-control" id="dim-single-init-len" placeholder="전장" /></td><td><input type="number" step="0.1" class="form-control" id="dim-single-init-gap" placeholder="끝단 클립 간격" /></td></tr>
                        <tr><td><strong>중물</strong></td><td><input type="number" step="0.1" class="form-control" id="dim-single-mid-len" placeholder="전장" /></td><td><input type="number" step="0.1" class="form-control" id="dim-single-mid-gap" placeholder="끝단 클립 간격" /></td></tr>
                        <tr><td><strong>종물</strong></td><td><input type="number" step="0.1" class="form-control" id="dim-single-fin-len" placeholder="전장" /></td><td><input type="number" step="0.1" class="form-control" id="dim-single-fin-gap" placeholder="끝단 클립 간격" /></td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="clip-sub-card">
                  <label class="form-label mb-1">🗑️ ⑤ 소재 LOSS &amp; 폐기 불량</label>
                  <div class="grid-2 mb-2">
                    <div><label class="form-label" style="font-size:0.78rem;">소재연결작업 LOSS (EA)</label><input type="number" class="form-control" id="clip-single-loss-join" min="0" value="0" /></div>
                    <div><label class="form-label" style="font-size:0.78rem;">소재불량 LOSS (EA)</label><input type="number" class="form-control" id="clip-single-loss-defect" min="0" value="0" /></div>
                  </div>
                  <div class="grid-2">
                    <div>
                      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem;">
                        <label class="form-label mb-0" style="font-size:0.78rem;">폐기불량 세부내용 (선택)</label>
                        <span class="badge badge-blue" style="font-size:0.68rem;padding:0.1rem 0.35rem;" title="작성 누적에 따라 다빈도 불량이 상단에 자동 정렬됩니다.">🔥 다빈도 상단정렬</span>
                      </div>
                      <select class="form-select" id="clip-single-waste-type" style="margin-bottom:0.35rem;"></select>
                      <input type="text" class="form-control" id="clip-single-waste-etc" placeholder="기타 세부 사유 입력" style="display:none;" />
                    </div>
                    <div><label class="form-label" style="font-size:0.78rem;color:var(--accent-rose);font-weight:700;">폐기불량 합계 (EA)</label><input type="number" class="form-control" id="clip-single-waste-total" min="0" value="0" style="color:var(--accent-rose);font-weight:700;" /></div>
                  </div>
                </div>
              </div>
            </div>

            <div id="prep-spec-card" class="card mb-3" style="display:none;">
              <div class="card-header">
                <div class="card-title" style="color:var(--accent-emerald);"><i class="ri-ruler-2-line"></i> 소재준비 공정 작업일보 서식</div>
                <span class="badge badge-emerald">DT CREW/QUAD</span>
