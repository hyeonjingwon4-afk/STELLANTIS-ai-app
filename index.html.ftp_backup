        ]
      },
      {
        id: 'mod_km_kx',
        name: 'KM/KX',
        parts: [
          {
            id: 'part_kmkx_hood',
            name: 'HOOD SURROUND',
            processes: [
              { id: 'proc_kmkx_clip', name: '클립머신', isMachine: true, target: 1000 },
              { id: 'proc_kmkx_joint', name: '조인트', isMachine: false, target: 1000 },
              { id: 'proc_kmkx_post', name: '후가공', isMachine: false, target: 1000 },
