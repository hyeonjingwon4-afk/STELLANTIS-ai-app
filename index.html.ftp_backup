                    <div class="grid-3 mb-2">
                      <div><label class="form-label" style="font-size:0.78rem;">초물 LOT No.</label><input type="text" class="form-control" id="prep-LH-lot-init" placeholder="초물 LOT" /></div>
                      <div><label class="form-label" style="font-size:0.78rem;">중물 LOT No.</label><input type="text" class="form-control" id="prep-LH-lot-mid" placeholder="중물 LOT" /></div>
                      <div><label class="form-label" style="font-size:0.78rem;">종물 LOT No.</label><input type="text" class="form-control" id="prep-LH-lot-fin" placeholder="종물 LOT" /></div>
