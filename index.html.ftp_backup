                  <th class="sortable" data-sort="passQty">양품수량 <i class="ri-arrow-up-down-line"></i></th>
                  <th class="sortable" data-sort="defectQty">불량수량 <i class="ri-arrow-up-down-line"></i></th>
                  <th class="sortable" data-sort="achieveRate">달성률 <i class="ri-arrow-up-down-line"></i></th>
                  <th class="sortable" data-sort="defectRate">불량률 <i class="ri-arrow-up-down-line"></i></th>
                  <th>비가동</th>
                  <th>상세보기</th>
                </tr>
              </thead>
              <tbody id="tbl-mgr-processes"></tbody>
            </table>
          </div>
        </div>

        <div class="card mb-3" style="border-left:4px solid var(--accent-rose);">
          <div class="card-header">
            <div class="card-title" style="color:var(--accent-rose);"><i class="ri-alarm-warning-line"></i> 🚨 생산 중단 / 비가동 신고 모아보기</div>
            <div style="display:flex;align-items:center;gap:0.5rem;">
              <span class="badge badge-rose" id="downtime-count-badge">0 건</span>
              <button type="button" class="btn btn-primary btn-sm" id="btn-open-line-alert-manual" style="background:#dc2626;border:none;font-weight:700;padding:0.25rem 0.6rem;font-size:0.78rem;">
                <i class="ri-alarm-warning-fill"></i> 🚨 비상 팝업 창 즉시 열기
              </button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>작업일자</th>
