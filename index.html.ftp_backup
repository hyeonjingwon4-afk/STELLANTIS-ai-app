                  <button type="button" class="btn btn-outline btn-sm prep-tab-btn" data-side="RH" style="flex:1;">RH 작성란</button>
                </div>

                <div id="prep-tab-content-LH" class="prep-tab-content">
                  <div class="clip-sub-card">
