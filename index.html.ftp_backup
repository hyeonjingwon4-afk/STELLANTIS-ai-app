                  <th>차종 / 부품 / 공정</th>
                  <th>라인(호기)</th>
                  <th>지속시간</th>
                  <th>중단 원인</th>
                  <th>세부 내용</th>
                </tr>
              </thead>
              <tbody id="tbl-downtime"></tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title"><i class="ri-file-list-line"></i> 제출된 전체 일지 데이터</div>
            <input type="text" class="form-control" id="log-search" placeholder="작업자/공정 검색" style="width:200px;" />
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>작업일자</th>
                  <th>작업자</th>
                  <th>차종 / 공정</th>
                  <th>시작시각</th>
                  <th>생산량</th>
                  <th>불량</th>
                  <th>불량률</th>
                  <th>비가동</th>
                  <th>상태</th>
                </tr>
              </thead>
              <tbody id="tbl-logs"></tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <div class="modal-backdrop" id="modal-qr-tool">
      <div class="modal-container">
        <div class="modal-header">
          <div class="modal-title"><i class="ri-qr-code-line"></i> 현장 근로자 접속용 QR 코드</div>
          <button type="button" class="btn btn-outline btn-sm" id="btn-close-qr-modal">&times;</button>
        </div>
        <div class="modal-body text-center">
          <p style="margin-bottom:1rem;color:var(--text-secondary);">휴대폰 카메라로 아래 QR 코드를 스캔하면 근로자 전용 작성 페이지로 바로 접속됩니다.</p>
          <div id="qr-code-img-box" style="background:white;padding:1.5rem;display:inline-block;border-radius:12px;margin-bottom:1rem;"></div>
          <p style="font-weight:700;color:var(--accent-blue);" id="qr-code-url-text"></p>
        </div>
      </div>
    </div>

    <div class="modal-backdrop" id="modal-process-detail-logs">
      <div class="modal-container modal-lg">
