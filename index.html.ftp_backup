    { id: 'item_1_2', name: 'DT CREW A RH', lenSpec: '779 ± 5mm', gapSpec: '28 ± 1mm / 121 ± 1mm' },
    { id: 'item_1_3', name: 'DT QUAD A LH', lenSpec: '509 ± 5mm', gapSpec: '121 ± 1mm / 28 ± 1mm' },
