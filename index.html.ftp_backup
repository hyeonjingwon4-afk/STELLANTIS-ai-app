            processes: [
              { id: 'proc_dss_prep_a', name: '소재준비(A)', isMachine: true, target: 1000 },
              { id: 'proc_dss_prep_c', name: '소재준비(C)', isMachine: true, target: 1000 },
              { id: 'proc_dss_joint', name: '조인트', isMachine: false, target: 1000 },
