            <label class="form-label">비밀번호를 입력하세요</label>
            <input type="password" class="form-control" id="mgr-login-pw" placeholder="비밀번호 입력..." />
          </div>
          <button type="button" class="btn btn-primary btn-block" id="btn-submit-mgr-login">로그인</button>
        </div>
      </div>
    </div>
  </div>

  <script>
const INITIAL_HIERARCHY = [
